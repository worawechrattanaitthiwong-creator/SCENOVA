# Database
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST:5432/scenova"
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/scenova"

# Authentication / Admin
SESSION_SECRET="replace-with-a-long-random-secret"
TWO_FACTOR_ENCRYPTION_KEY="replace-with-a-random-32-byte-secret"
SCENOVA_ADMIN_EMAIL="admin@yourdomain.com"
SCENOVA_ADMIN_PASSWORD="replace-with-a-strong-password"

# AI Agent orchestration / worker
AGENT_DEFAULT_RUN_BUDGET_THB="500"
AGENT_HARD_RUN_BUDGET_THB="2000"
AGENT_APPROVAL_THRESHOLD_THB="150"
AGENT_MAX_EPISODES_PER_RUN="10"
AGENT_MAX_RETRIES_PER_STEP="2"
AGENT_MAX_PROVIDER_SWITCHES="1"
AGENT_MAX_LLM_CALLS_PER_RUN="80"
AGENT_MAX_LLM_CALLS_PER_CLIP="15"
AGENT_MAX_CONCURRENT_RUNS_PER_USER="2"
AGENT_QUEUE_LEASE_SECONDS="120"
AGENT_WORKER_POLL_MS="1000"
AGENT_PROVIDER_POLL_MS="5000"
AGENT_WORKER_CONCURRENCY="2"
AGENT_WORKER_ID=""
AGENT_ALLOW_MOCK_PROVIDER_FALLBACK="false"

# LLM Brain / Model Router
# Keep false until OPENAI_API_KEY is configured. When false, Agent and AI Suggest use deterministic no-cost fallbacks.
SCENOVA_LLM_ENABLED="false"
SCENOVA_LLM_FAST_MODEL="gpt-5.6-luna"
SCENOVA_LLM_BALANCED_MODEL="gpt-5.6-terra"
SCENOVA_LLM_PREMIUM_MODEL="gpt-5.6-sol"
OPENAI_API_KEY=""
OPENAI_API_BASE_URL="https://api.openai.com/v1"
AI_SUGGEST_MAX_CALLS_PER_USER_DAY="100"
LLM_DAILY_BUDGET_THB="1000"
LLM_MONTHLY_BUDGET_THB="20000"
LLM_USER_DAILY_BUDGET_THB="100"
LLM_USER_MONTHLY_BUDGET_THB="2000"
# Optional pricing overrides (USD per 1M tokens). Defaults are maintained in lib/llm/pricing.ts.
# LLM_PRICE_GPT_5_6_LUNA_INPUT_USD_PER_M="0.20"
# LLM_PRICE_GPT_5_6_LUNA_CACHED_INPUT_USD_PER_M="0.02"
# LLM_PRICE_GPT_5_6_LUNA_OUTPUT_USD_PER_M="1.20"
# LLM_PRICE_OPENAI_GPT_OSS_20B_INPUT_USD_PER_M="0.075"
# LLM_PRICE_OPENAI_GPT_OSS_20B_OUTPUT_USD_PER_M="0.30"

# Groq production analyzer
# System key is used when the user selects SYSTEM or AUTO has no BYOK Groq connection.
GROQ_API_KEY=""
# Platform fee charged by SCENOVA per successful analysis. Provider token cost is paid by the user's Groq account in BYOK mode.
SCENOVA_BYOK_ANALYZER_CREDIT_FEE="1"
SCENOVA_SYSTEM_ANALYZER_CREDIT_FEE="1"

# Credit pricing / transparency
SCENOVA_CREDITS_PER_THB="1"
SCENOVA_CREDIT_QUOTE_BUFFER_PCT="10"
# Keep AI planning/prompt/continuity bundled into generation by default; change only if product pricing changes.
SCENOVA_AGENT_CREDIT_FEE="0"
SCENOVA_INTERNAL_PROMPT_CREDIT_FEE="0"
SCENOVA_CONTINUITY_CREDIT_FEE="0"
PROMPT_EXPORT_CREDITS="3"
PROMPT_EXPORT_PRO_CREDITS="5"
SCENOVA_USD_THB_RATE="33"

# Video providers
# Real video calls are hard-disabled unless this flag is true AND the provider key exists.
SCENOVA_REAL_VIDEO_PROVIDERS="false"
SEEDANCE_API_KEY=""
SEEDANCE_API_BASE_URL="https://operator.las.ap-southeast-1.bytepluses.com/api/v1"
SEEDANCE_MODEL_ID="dreamina-seedance-2-5-260628"
SEEDANCE_BASE_USD_PER_SECOND="0.303"
SEEDANCE_480P_CONVERSION="0.6785"
SEEDANCE_720P_CONVERSION="1.525"
SEEDANCE_VIDEO_REFERENCE_COST_FACTOR="1.8"
SEEDANCE_EXECUTION_EXPIRES_SECONDS="7200"
SEEDANCE_DEFAULT_RATIO="16:9"
KLING_API_KEY=""
VEO_API_KEY=""
RUNWAY_API_KEY=""
WAN_API_KEY=""

# Optional future LLM providers
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
OPENROUTER_API_KEY=""

# Payment providers (connect before public paid top-ups)
OPN_PUBLIC_KEY=""
OPN_SECRET_KEY=""
STRIPE_SECRET_KEY=""
PAYMENT_WEBHOOK_SECRET=""

# Storage / security
STORAGE_BUCKET=""
STORAGE_SIGNING_SECRET=""
# 32-byte key used only server-side to encrypt user BYOK API keys with AES-256-GCM.
# Recommended: openssl rand -base64 32
API_KEY_ENCRYPTION_KEY=""
# Absolute environment-level emergency lock. When true, the Admin UI cannot override it.
SCENOVA_EMERGENCY_LOCKDOWN="false"
# Generation-only hard lock retained as a second independent safety switch.
SCENOVA_GENERATION_KILL_SWITCH="false"
# When the Admin enables Emergency Rate Profile without full lockdown, these become strict per-minute ceilings.
EMERGENCY_LLM_CALLS_PER_MINUTE="5"
EMERGENCY_AGENT_RUNS_PER_MINUTE="1"
EMERGENCY_VIDEO_CALLS_PER_MINUTE="2"
