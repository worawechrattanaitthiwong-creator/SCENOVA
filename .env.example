# Database
# DATABASE_URL = Neon pooled connection (host normally contains -pooler)
# DIRECT_URL   = Neon direct connection (used by Prisma migrations)
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST/neondb?sslmode=require"

# Authentication / first Admin bootstrap
# Generate SESSION_SECRET with: openssl rand -base64 48
SESSION_SECRET="replace-with-a-long-random-secret"
SCENOVA_ADMIN_EMAIL="admin@yourdomain.com"
SCENOVA_ADMIN_PASSWORD="replace-with-a-strong-password"

# Video providers (connect later)
SEEDANCE_API_KEY=""
KLING_API_KEY=""
VEO_API_KEY=""
RUNWAY_API_KEY=""
WAN_API_KEY=""

# Prompt AI providers (connect later)
OPENAI_API_KEY=""
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""

# Payment providers (connect at final stage)
OPN_PUBLIC_KEY=""
OPN_SECRET_KEY=""
STRIPE_SECRET_KEY=""
PAYMENT_WEBHOOK_SECRET=""

# Storage / security
STORAGE_BUCKET=""
STORAGE_SIGNING_SECRET=""
SCENOVA_GENERATION_KILL_SWITCH="false"
