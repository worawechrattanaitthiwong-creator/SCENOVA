{
  "name": "scenova",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "prisma generate",
    "build": "next build",
    "dev": "next dev",
    "dev:fast": "next dev --turbopack",
    "start": "next start",
    "agent:worker": "tsx scripts/agent-worker.ts",
    "emergency:status": "tsx scripts/emergency-security.ts status",
    "emergency:lockdown": "tsx scripts/emergency-security.ts lockdown",
    "emergency:revoke-sessions": "tsx scripts/emergency-security.ts revoke-sessions",
    "emergency:restore": "tsx scripts/emergency-security.ts restore",
    "prelint": "prisma generate",
    "lint": "tsc --noEmit",
    "pretypecheck": "prisma generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.1",
    "@opennextjs/cloudflare": "^1.20.2",
    "@prisma/adapter-neon": "6.19.3",
    "@prisma/client": "6.19.3",
    "next": "^15.5.21",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.17.2",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "prisma": "6.19.3",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.4",
    "wrangler": "^4.125.0"
  }
}
