generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  runtime      = "cloudflare"
  engineType   = "client"
  moduleFormat = "esm"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  MEMBER
}

model User {
  id                     String               @id @default(cuid())
  email                  String               @unique
  displayName            String?
  passwordHash           String
  role                   UserRole             @default(MEMBER)
  active                 Boolean              @default(true)
  lastLoginAt            DateTime?
  twoFactorEnabled       Boolean              @default(false)
  twoFactorSecret        String?
  twoFactorConfirmedAt   DateTime?
  twoFactorRecoveryCodes Json?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  projects               Project[]
  wallet                 Wallet?
  jobs                   GenerationJob[]
  auditLogs              AuditLog[]
  agentRuns              AgentRun[]
  llmUsageEvents         LlmUsageEvent[]
  creditReservations     CreditReservation[]
  costQuotes             CostQuote[]
  costUsageEvents        CostUsageEvent[]
  promptExportUnlocks    PromptExportUnlock[]
}

model Project {
  id            String          @id @default(cuid())
  userId        String
  title         String
  story         String          @db.Text
  genre         String
  mood          String
  aspectRatio   String
  episodeCount  Int?
  openEnded     Boolean         @default(false)
  mainModelId   String
  modelMode     String
  promptMode    String
  resolution    String
  stylePresetId String?
  projectBible  String          @db.Text
  locksJson     Json
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  characters    Character[]
  locations     Location[]
  props         Prop[]
  canonFacts    CanonFact[]
  episodes      Episode[]
  assets        Asset[]
  jobs          GenerationJob[]

  @@index([userId, updatedAt])
}

model Character {
  id           String               @id @default(cuid())
  projectId    String
  externalKey  String
  name         String
  kind         String
  description  String               @db.Text
  appearance   String               @db.Text
  outfit       String               @db.Text
  personality  String               @db.Text
  voiceProfile String?
  lockEnabled  Boolean              @default(true)
  version      Int                  @default(1)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  project      Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  references   CharacterReference[]

  @@unique([projectId, externalKey])
}

model CharacterReference {
  id          String    @id @default(cuid())
  characterId String
  label       String
  kind        String
  assetId     String?
  createdAt   DateTime  @default(now())
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  asset       Asset?    @relation(fields: [assetId], references: [id], onDelete: SetNull)
}

model Location {
  id          String  @id @default(cuid())
  projectId   String
  externalKey String
  name        String
  description String  @db.Text
  lockEnabled Boolean @default(true)
  stateJson   Json?
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, externalKey])
}

model Prop {
  id          String  @id @default(cuid())
  projectId   String
  externalKey String
  name        String
  description String  @db.Text
  lockEnabled Boolean @default(true)
  stateJson   Json?
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, externalKey])
}

model CanonFact {
  id        String   @id @default(cuid())
  projectId String
  text      String   @db.Text
  locked    Boolean  @default(true)
  sourceEp  Int?
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Episode {
  id          String            @id @default(cuid())
  projectId   String
  number      Int
  title       String
  durationSec Int
  synopsis    String            @db.Text
  status      String
  locked      Boolean           @default(false)
  endState    Json?
  lastFrame   String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  segments    TimelineSegment[]
  jobs        GenerationJob[]

  @@unique([projectId, number])
}

model TimelineSegment {
  id           String         @id @default(cuid())
  episodeId    String
  startSec     Float
  endSec       Float
  title        String
  scene        String         @db.Text
  locationKey  String?
  action       String         @db.Text
  emotion      String
  lighting     String         @db.Text
  sound        String         @db.Text
  modelId      String?
  characterIds Json
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  episode      Episode        @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  cameraShots  CameraShot[]
  dialogue     DialogueBeat[]

  @@index([episodeId, startSec])
}

model CameraShot {
  id                  String          @id @default(cuid())
  timelineSegmentId   String
  startSec            Float
  endSec              Float
  shotType            String
  angle               String
  lensMm              Float
  cameraHeight        String
  movement            String
  movementSpeed       String
  focus               String
  depthOfField        String
  composition         String          @db.Text
  foregroundOcclusion String          @db.Text
  segment             TimelineSegment @relation(fields: [timelineSegmentId], references: [id], onDelete: Cascade)
}

model DialogueBeat {
  id                String          @id @default(cuid())
  timelineSegmentId String
  characterKey      String
  startSec          Float
  endSec            Float
  text              String          @db.Text
  emotion           String
  speed             String
  segment           TimelineSegment @relation(fields: [timelineSegmentId], references: [id], onDelete: Cascade)
}

model Asset {
  id          String               @id @default(cuid())
  projectId   String
  kind        String
  storageKey  String
  mimeType    String
  sizeBytes   Int
  durationSec Float?
  metadata    Json?
  createdAt   DateTime             @default(now())
  project     Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  references  CharacterReference[]
}

model GenerationJob {
  id                String   @id @default(cuid())
  userId            String
  projectId         String
  episodeId         String
  provider          String
  modelId           String
  providerTaskId    String?
  idempotencyKey    String   @unique
  startSec          Float
  endSec            Float
  resolution        String
  status            String
  promptSnapshot    Json
  referenceSnapshot Json?
  continuityState   Json?
  outputAssetKey    String?
  lastFrameAssetKey String?
  estimatedCostThb  Decimal? @db.Decimal(12, 4)
  actualCostThb     Decimal? @db.Decimal(12, 4)
  errorCode         String?
  errorMessage      String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  episode           Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([projectId, status])
}

model Wallet {
  id            String              @id @default(cuid())
  userId        String              @unique
  paidBalance   Int                 @default(0)
  bonusBalance  Int                 @default(0)
  reserved      Int                 @default(0)
  updatedAt     DateTime            @updatedAt
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledgerEntries WalletLedger[]
  reservations  CreditReservation[]
}

model WalletLedger {
  id             String   @id @default(cuid())
  walletId       String
  type           String
  credits        Int
  balanceAfter   Int
  referenceType  String?
  referenceId    String?
  idempotencyKey String   @unique
  metadata       Json?
  createdAt      DateTime @default(now())
  wallet         Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
}

model CreditReservation {
  id             String    @id
  walletId       String
  userId         String
  status         String    @default("reserved")
  credits        Int
  chargedCredits Int       @default(0)
  purpose        String
  category       String
  referenceId    String
  idempotencyKey String    @unique
  metadata       Json?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt
  wallet         Wallet    @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, expiresAt])
}

model CostQuote {
  id               String           @id
  userId           String
  referenceType    String
  referenceId      String
  status           String           @default("PREVIEW")
  estimatedCredits Int
  maxCredits       Int
  actualCredits    Int              @default(0)
  itemsJson        Json
  expiresAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @default(now()) @updatedAt
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  usageEvents      CostUsageEvent[]

  @@index([userId, createdAt])
  @@index([referenceType, referenceId])
}

model CostUsageEvent {
  id            String     @id
  userId        String
  quoteId       String?
  category      String
  label         String
  phase         String
  credits       Int        @default(0)
  costThb       Decimal?   @db.Decimal(12, 4)
  providerId    String?
  modelId       String?
  referenceType String?
  referenceId   String?
  projectId     String?
  episodeId     String?
  sceneId       String?
  metadata      Json?
  createdAt     DateTime   @default(now())
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  quote         CostQuote? @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([quoteId, createdAt])
  @@index([category, createdAt])
}

model LlmUsageEvent {
  id                String    @id
  userId            String
  runId             String?
  provider          String
  modelId           String
  category          String
  inputTokens       Int       @default(0)
  cachedInputTokens Int       @default(0)
  outputTokens      Int       @default(0)
  costThb           Decimal   @default(0) @db.Decimal(12, 6)
  referenceType     String?
  referenceId       String?
  metadata          Json?
  createdAt         DateTime  @default(now())
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  run               AgentRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([runId, createdAt])
  @@index([modelId, createdAt])
  @@index([category, createdAt])
}

model PromptExportUnlock {
  id                String   @id
  userId            String
  promptFingerprint String
  version           Int      @default(1)
  scope             String   @default("production")
  creditsCharged    Int      @default(0)
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, promptFingerprint, version, scope])
  @@index([userId, createdAt])
}

model PaymentTransaction {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerPaymentId String?  @unique
  amountThb         Decimal  @db.Decimal(12, 2)
  credits           Int
  status            String
  idempotencyKey    String   @unique
  metadata          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  ipHash     String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
}

model AgentRun {
  id                   String             @id
  userId               String
  mode                 String
  status               String             @default("QUEUED")
  stage                String             @default("PLAN_STORY")
  inputJson            Json
  planJson             Json?
  stateJson            Json               @default("{}")
  budgetThb            Decimal            @db.Decimal(12, 4)
  estimatedSpendThb    Decimal            @default(0) @db.Decimal(12, 4)
  actualSpendThb       Decimal            @default(0) @db.Decimal(12, 4)
  approvalThresholdThb Decimal            @db.Decimal(12, 4)
  maxEpisodes          Int                @default(1)
  stopReason           String?
  startedAt            DateTime?
  finishedAt           DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @default(now()) @updatedAt
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  queueJobs            AgentQueueJob[]
  decisions            AgentDecisionLog[]
  approvals            AgentApproval[]
  llmUsageEvents       LlmUsageEvent[]
  workflow             AgentWorkflow?
  agentTasks           AgentTask[]
  agentArtifacts       AgentArtifact[]
  agentHandoffs        AgentHandoff[]
  agentReviews         AgentReview[]
  humanCheckpoints     HumanCheckpoint[]

  @@index([userId, createdAt])
  @@index([status, stage])
}

model AgentDefinition {
  key                String      @id
  nameTh             String
  nameEn             String
  description        String      @db.Text
  modelTier          String      @default("balanced")
  instructionVersion Int         @default(1)
  inputTypes         Json        @default("[]")
  outputType         String
  toolsJson          Json        @default("[]")
  enabled            Boolean     @default(true)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @default(now()) @updatedAt
  tasks              AgentTask[]
}

model AgentWorkflow {
  id             String         @id
  runId          String         @unique
  workflowKey    String         @default("SCENOVA_FILM_PRODUCTION")
  version        Int            @default(1)
  status         String         @default("ACTIVE")
  definitionJson Json
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @default(now()) @updatedAt
  run            AgentRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  tasks          AgentTask[]
  handoffs       AgentHandoff[]

  @@index([status, updatedAt])
}

model AgentTask {
  id             String            @id
  workflowId     String
  runId          String
  agentKey       String
  stage          String
  scopeKey       String
  status         String            @default("PENDING")
  sequence       Int
  attempt        Int               @default(0)
  maxAttempts    Int               @default(3)
  inputJson      Json              @default("{}")
  outputJson     Json?
  idempotencyKey String            @unique
  startedAt      DateTime?
  completedAt    DateTime?
  lastError      String?           @db.Text
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @default(now()) @updatedAt
  workflow       AgentWorkflow     @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  run            AgentRun          @relation(fields: [runId], references: [id], onDelete: Cascade)
  agent          AgentDefinition   @relation(fields: [agentKey], references: [key], onDelete: Restrict)
  artifacts      AgentArtifact[]
  outgoing       AgentHandoff[]    @relation("HandoffSourceTask")
  incoming       AgentHandoff[]    @relation("HandoffTargetTask")
  reviews        AgentReview[]
  checkpoints    HumanCheckpoint[]

  @@unique([runId, stage, scopeKey])
  @@index([workflowId, status, sequence])
  @@index([runId, scopeKey, sequence])
  @@index([agentKey, status])
}

model AgentArtifact {
  id            String            @id
  runId         String
  taskId        String
  type          String
  scopeKey      String
  version       Int               @default(1)
  schemaVersion Int               @default(1)
  status        String            @default("DRAFT")
  summary       String
  contentJson   Json
  lineageJson   Json              @default("[]")
  checksum      String?
  createdAt     DateTime          @default(now())
  run           AgentRun          @relation(fields: [runId], references: [id], onDelete: Cascade)
  task          AgentTask         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  handoffs      AgentHandoff[]
  reviews       AgentReview[]
  checkpoints   HumanCheckpoint[]

  @@unique([runId, type, scopeKey, version])
  @@index([runId, scopeKey, createdAt])
  @@index([taskId, createdAt])
}

model AgentHandoff {
  id              String        @id
  workflowId      String
  runId           String
  fromTaskId      String
  toTaskId        String
  artifactId      String
  status          String        @default("CREATED")
  contractVersion Int           @default(1)
  payloadJson     Json
  acceptedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?       @db.Text
  createdAt       DateTime      @default(now())
  workflow        AgentWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  run             AgentRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  fromTask        AgentTask     @relation("HandoffSourceTask", fields: [fromTaskId], references: [id], onDelete: Cascade)
  toTask          AgentTask     @relation("HandoffTargetTask", fields: [toTaskId], references: [id], onDelete: Cascade)
  artifact        AgentArtifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@unique([fromTaskId, toTaskId, artifactId])
  @@index([runId, status, createdAt])
  @@index([toTaskId, status])
}

model AgentReview {
  id               String         @id
  runId            String
  taskId           String
  artifactId       String?
  reviewerAgentKey String
  verdict          String
  score            Int?
  summary          String
  issuesJson       Json           @default("[]")
  createdAt        DateTime       @default(now())
  run              AgentRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  task             AgentTask      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  artifact         AgentArtifact? @relation(fields: [artifactId], references: [id], onDelete: SetNull)

  @@index([runId, createdAt])
  @@index([artifactId, verdict])
}

model HumanCheckpoint {
  id              String         @id
  runId           String
  taskId          String?
  artifactId      String?
  kind            String
  status          String         @default("PENDING")
  required        Boolean        @default(true)
  summary         String
  payloadJson     Json           @default("{}")
  requestedAt     DateTime       @default(now())
  expiresAt       DateTime?
  decidedAt       DateTime?
  decidedByUserId String?
  run             AgentRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  task            AgentTask?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  artifact        AgentArtifact? @relation(fields: [artifactId], references: [id], onDelete: SetNull)

  @@index([runId, status, requestedAt])
}

model AgentQueueJob {
  id             String    @id
  runId          String
  kind           String    @default("AGENT_STEP")
  status         String    @default("QUEUED")
  payloadJson    Json      @default("{}")
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3)
  availableAt    DateTime  @default(now())
  lockedAt       DateTime?
  lockedBy       String?
  heartbeatAt    DateTime?
  leaseExpiresAt DateTime?
  idempotencyKey String    @unique
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt
  run            AgentRun  @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([status, leaseExpiresAt])
  @@index([runId, createdAt])
}

model AgentDecisionLog {
  id         String   @id
  runId      String
  stage      String
  action     String
  reason     String
  providerId String?
  metadata   Json?
  createdAt  DateTime @default(now())
  run        AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, createdAt])
}

model AgentApproval {
  id               String    @id
  runId            String
  kind             String    @default("BUDGET_PLAN")
  status           String    @default("PENDING")
  estimatedCostThb Decimal   @db.Decimal(12, 4)
  summary          String
  requestedAt      DateTime  @default(now())
  expiresAt        DateTime?
  decidedAt        DateTime?
  decidedByUserId  String?
  run              AgentRun  @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, status])
}

model SystemSecurityState {
  id                        String    @id
  lockdownEnabled           Boolean   @default(false)
  maintenanceMode           Boolean   @default(false)
  generationDisabled        Boolean   @default(false)
  agentDisabled             Boolean   @default(false)
  llmDisabled               Boolean   @default(false)
  paymentDisabled           Boolean   @default(false)
  newLoginRestricted        Boolean   @default(false)
  queuePaused               Boolean   @default(false)
  emergencyRateLimitEnabled Boolean   @default(false)
  disabledProviderIds       Json      @default("[]")
  sessionInvalidBefore      DateTime?
  reason                    String?
  updatedByUserId           String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @default(now()) @updatedAt
}

model EmergencyRateLimitBucket {
  bucketKey   String
  windowStart DateTime
  count       Int      @default(0)
  updatedAt   DateTime @default(now()) @updatedAt

  @@id([bucketKey, windowStart])
  @@index([windowStart])
}
