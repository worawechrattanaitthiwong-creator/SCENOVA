generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  MEMBER
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  displayName  String?
  passwordHash String
  role         UserRole  @default(MEMBER)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  projects     Project[]
  wallet       Wallet?
  jobs         GenerationJob[]
  auditLogs    AuditLog[]
}

model Project {
  id            String   @id @default(cuid())
  userId        String
  title         String
  story         String   @db.Text
  genre         String
  mood          String
  aspectRatio   String
  episodeCount  Int?
  openEnded     Boolean  @default(false)
  mainModelId   String
  modelMode     String
  promptMode    String
  resolution    String
  stylePresetId String?
  projectBible  String   @db.Text
  locksJson     Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  characters    Character[]
  locations     Location[]
  props         Prop[]
  canonFacts    CanonFact[]
  episodes      Episode[]
  assets        Asset[]
  jobs          GenerationJob[]

  @@index([userId, updatedAt])
}

model Character {
  id            String   @id @default(cuid())
  projectId     String
  externalKey   String
  name          String
  kind          String
  description   String   @db.Text
  appearance    String   @db.Text
  outfit        String   @db.Text
  personality   String   @db.Text
  voiceProfile  String?
  lockEnabled   Boolean  @default(true)
  version       Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  references    CharacterReference[]

  @@unique([projectId, externalKey])
}

model CharacterReference {
  id          String    @id @default(cuid())
  characterId String
  label       String
  kind        String
  assetId     String?
  createdAt   DateTime  @default(now())
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  asset       Asset?    @relation(fields: [assetId], references: [id], onDelete: SetNull)
}

model Location {
  id          String   @id @default(cuid())
  projectId   String
  externalKey String
  name        String
  description String   @db.Text
  lockEnabled Boolean  @default(true)
  stateJson   Json?
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, externalKey])
}

model Prop {
  id          String   @id @default(cuid())
  projectId   String
  externalKey String
  name        String
  description String   @db.Text
  lockEnabled Boolean  @default(true)
  stateJson   Json?
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, externalKey])
}

model CanonFact {
  id        String   @id @default(cuid())
  projectId String
  text      String   @db.Text
  locked    Boolean  @default(true)
  sourceEp  Int?
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Episode {
  id          String   @id @default(cuid())
  projectId   String
  number      Int
  title       String
  durationSec Int
  synopsis    String   @db.Text
  status      String
  locked      Boolean  @default(false)
  endState    Json?
  lastFrame   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  segments    TimelineSegment[]
  jobs        GenerationJob[]

  @@unique([projectId, number])
}

model TimelineSegment {
  id           String   @id @default(cuid())
  episodeId    String
  startSec     Float
  endSec       Float
  title        String
  scene        String   @db.Text
  locationKey  String?
  action       String   @db.Text
  emotion      String
  lighting     String   @db.Text
  sound        String   @db.Text
  modelId      String?
  characterIds Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  episode      Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  cameraShots  CameraShot[]
  dialogue     DialogueBeat[]

  @@index([episodeId, startSec])
}

model CameraShot {
  id                  String          @id @default(cuid())
  timelineSegmentId   String
  startSec             Float
  endSec               Float
  shotType             String
  angle                String
  lensMm               Float
  cameraHeight         String
  movement             String
  movementSpeed        String
  focus                String
  depthOfField         String
  composition          String          @db.Text
  foregroundOcclusion String          @db.Text
  segment              TimelineSegment @relation(fields: [timelineSegmentId], references: [id], onDelete: Cascade)
}

model DialogueBeat {
  id                String          @id @default(cuid())
  timelineSegmentId String
  characterKey      String
  startSec           Float
  endSec             Float
  text               String          @db.Text
  emotion            String
  speed              String
  segment            TimelineSegment @relation(fields: [timelineSegmentId], references: [id], onDelete: Cascade)
}

model Asset {
  id          String   @id @default(cuid())
  projectId   String
  kind        String
  storageKey  String
  mimeType    String
  sizeBytes   Int
  durationSec Float?
  metadata    Json?
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  references  CharacterReference[]
}

model GenerationJob {
  id                String   @id @default(cuid())
  userId            String
  projectId         String
  episodeId         String
  provider          String
  modelId           String
  providerTaskId    String?
  idempotencyKey    String   @unique
  startSec          Float
  endSec            Float
  resolution        String
  status            String
  promptSnapshot    Json
  referenceSnapshot Json?
  continuityState   Json?
  outputAssetKey    String?
  lastFrameAssetKey String?
  estimatedCostThb  Decimal? @db.Decimal(12, 4)
  actualCostThb     Decimal? @db.Decimal(12, 4)
  errorCode         String?
  errorMessage      String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  episode           Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([projectId, status])
}

model Wallet {
  id             String   @id @default(cuid())
  userId         String   @unique
  paidBalance    Int      @default(0)
  bonusBalance   Int      @default(0)
  reserved       Int      @default(0)
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledgerEntries  WalletLedger[]
}

model WalletLedger {
  id             String   @id @default(cuid())
  walletId       String
  type           String
  credits        Int
  balanceAfter   Int
  referenceType  String?
  referenceId    String?
  idempotencyKey String   @unique
  metadata       Json?
  createdAt      DateTime @default(now())
  wallet         Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
}

model PaymentTransaction {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerPaymentId String?  @unique
  amountThb         Decimal  @db.Decimal(12, 2)
  credits           Int
  status            String
  idempotencyKey    String   @unique
  metadata          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  ipHash     String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
}
